{
  "name": "pumpkin-weigh-in",
  "version": "1.1.0",
  "private": true,
  "description": "Pumpkin Weigh-In — CodePen Challenge entry: the categories in pumpkin.js, the page in index.html. Tests only; no runtime dependencies.",
  "license": "MIT",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@babel/preset-env": "7.25.4",
    "babel-jest": "29.7.0",
    "jest": "29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/pumpkin.test.js"
    ],
    "collectCoverageFrom": [
      "pumpkin.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 100,
        "functions": 100
      }
    }
  }
}
