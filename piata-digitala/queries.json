{
  "base": "https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data/",
  "about": "Eurostat Statistics API (JSON-stat 2.0, CORS). Shared by piata-digitala/index.html (live) and scripts/fetch-eurostat.mjs (snapshot). No geo filter: every country plus the EU aggregates come back in one small response.",
  "queries": {
    "buyers": { "dataset": "isoc_ec_ib20", "params": { "indic_is": "I_BLT12", "unit": "PC_IND_ILT12", "ind_type": "IND_TOTAL" } },
    "buyersOld": { "dataset": "isoc_ec_ibuy", "params": { "indic_is": "I_BLT12", "unit": "PC_IND_ILT12", "ind_type": "IND_TOTAL", "sinceTimePeriod": "2014" } },
    "age": { "dataset": "isoc_ec_ib20", "params": { "indic_is": "I_BLT12", "unit": "PC_IND_ILT12", "ind_type": ["Y16_24", "Y25_54", "Y55_74"] } },
    "internet": { "dataset": "isoc_ci_ifp_iu", "params": { "indic_is": "I_ILT12", "unit": "PC_IND", "ind_type": "IND_TOTAL", "sinceTimePeriod": "2014" } }
  }
}
