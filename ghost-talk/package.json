{
  "name": "ghost-talk",
  "version": "4.0.0",
  "private": true,
  "description": "Ghost Talk — CodePen Challenge entry (ghosttalk.js) plus the optional Ghost Lab. Tests only; no runtime dependencies.",
  "license": "MIT",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "build:lab": "node lab/build-standalone.cjs"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@babel/preset-env": "7.25.4",
    "babel-jest": "29.7.0",
    "jest": "29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/ghosttalk.test.js",
      "<rootDir>/lab/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "ghosttalk.js",
      "lab/engine.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "functions": 90
      }
    }
  }
}
