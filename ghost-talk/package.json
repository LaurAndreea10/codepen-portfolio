{
  "name": "ghost-talk",
  "version": "3.0.0",
  "private": true,
  "description": "Ghost Talk — bilingual ghost-language lab. Tests only; the app itself has no runtime dependencies.",
  "license": "MIT",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "build:standalone": "node build-standalone.cjs"
  },
  "devDependencies": {
    "jest": "29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["<rootDir>/tests/**/*.test.js"],
    "collectCoverageFrom": ["engine.js"],
    "coverageThreshold": { "global": { "lines": 90, "functions": 90 } }
  }
}
